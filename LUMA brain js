export async function talkToLuma(message) {
  const res = await fetch("https://api.openai.com/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_OPENAI_KEY" // we will add this next
    },
    body: JSON.stringify({
      model: "gpt-5",
      messages: [{ role: "user", content: `You are LUMA, a ruthless CEO coach. ${message}` }]
    })
  })
  return res.json()
}
